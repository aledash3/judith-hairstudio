# ==============================================================================
# Judith HairStudio — Environment Configuration (.env.example)
# ==============================================================================

# Database Connectivity (MongoDB Atlas or Local Instance)
MONGODB_URI=mongodb://localhost:27017/judith-hairstudio

# Server & Application Configuration
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage Driver Configuration ('local' or 'cloudinary')
# - 'local': Saves files to public/uploads/ (recommended for development and Docker with volume)
# - 'cloudinary': Uploads optimized WebP files to Cloudinary (recommended for Serverless / Vercel)
STORAGE_DRIVER=local

# Cloudinary Credentials (Required only if STORAGE_DRIVER=cloudinary)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Security: HTTP Basic Auth Protection (Opt-in for VPS / Public IP deployments)
# ⚠️ SECURITY WARNING: Basic Auth MUST only be enabled behind HTTPS (TLS termination via Nginx/Caddy).
# Never enable this on plain HTTP across public networks.
ENABLE_BASIC_AUTH=false
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change_this_secure_password
